<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand_green">#126B55</color>
    <color name="page_background">#F7FAF8</color>
    <color name="text_primary">#172B24</color>
    <color name="text_secondary">#3D5149</color>
    <dimen name="screen_spacing">24dp</dimen>
    <style name="BaseTheme.Fonesi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_green</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Fonesi" parent="BaseTheme.Fonesi" />
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="GuestAction" parent="android:style/Widget.Material.Light.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
