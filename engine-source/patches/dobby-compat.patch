diff --git a/source/PlatformUnifiedInterface/platform.h b/source/PlatformUnifiedInterface/platform.h
index b946514..50bf11b 100644
--- a/source/PlatformUnifiedInterface/platform.h
+++ b/source/PlatformUnifiedInterface/platform.h
@@ -91 +91,12 @@ public:
-};
\ No newline at end of file
+};
+
+// Fonesi: define after OSMemory; common.h includes the feature declarations recursively.
+namespace features { namespace android {
+inline void make_memory_readable(void *address, size_t size) {
+#if defined(ANDROID)
+  auto page = (void *)ALIGN_FLOOR(address, OSMemory::PageSize());
+  auto span = (size_t)ALIGN_CEIL((addr_t)address + size - (addr_t)page, OSMemory::PageSize());
+  OSMemory::SetPermission(page, span, kReadExecute);
+#endif
+}
+} }
